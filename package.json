{
  "name": "shopfloor",
  "version": "1.0.0",
  "description": "Open-source NetSuite SuiteScript 2.1 starter in TypeScript for small businesses, light manufacturers, and local shops",
  "license": "MIT",
  "keywords": [
    "netsuite",
    "suitescript",
    "typescript",
    "small-business",
    "manufacturing",
    "retail",
    "inventory",
    "starter"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:netsuite",
    "build:watch": "tsc --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "deploy": "npm run build && npm run stage && cd suitecloud && suitecloud project:deploy",
    "validate": "npm run build && npm run stage && cd suitecloud && suitecloud project:validate",
    "clean": "rm -rf build/",
    "agent:validate": "ts-node --project agent/tsconfig.json agent/harness.ts validate",
    "agent:scaffold": "ts-node --project agent/tsconfig.json agent/harness.ts scaffold",
    "agent:context": "ts-node --project agent/tsconfig.json agent/harness.ts context",
    "stage": "bash scripts/stage-suitecloud.sh && npm run sdf --silent",
    "sdf": "ts-node --project scripts/tsconfig.json scripts/generate-sdf.ts",
    "sdf:check": "npm run sdf -- --check",
    "demo": "npm run build:core --silent && node examples/demo.js",
    "test:core": "jest src/core --coverage --collectCoverageFrom=\"src/core/**/*.ts\" --collectCoverageFrom=\"!src/core/**/__tests__/**\"",
    "build:core": "rm -rf dist/core && tsc -p tsconfig.core.json",
    "build:netsuite": "tsc && node scripts/check-amd.js"
  },
  "devDependencies": {
    "@hitc/netsuite-types": "^2024.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "files": [
    "dist/core",
    "LICENSE",
    "README.md"
  ]
}
