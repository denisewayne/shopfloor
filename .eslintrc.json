{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "es2019": true
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/explicit-function-return-type": "warn",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "error"
  },
  "overrides": [
    {
      "files": [
        "src/core/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "N/*",
                  "N"
                ],
                "message": "src/core must stay platform-agnostic. Put NetSuite code in src/netsuite."
              },
              {
                "group": [
                  "**/netsuite/**",
                  "../netsuite/*",
                  "../../netsuite/*"
                ],
                "message": "src/core must not depend on src/netsuite."
              }
            ]
          }
        ]
      }
    }
  ]
}
